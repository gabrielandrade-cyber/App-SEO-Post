{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optmos",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Logs de invocacao ligados. Nenhuma chave de usuario aparece neles: as
  // chaves trafegam no corpo do POST e a do Gemini vai em header, nunca na URL.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  // Token de acesso opcional dos endpoints. Defina como secret, nunca aqui:
  //   npx wrangler secret put OPTMOS_ACCESS_TOKEN
  // e cole o mesmo valor no painel do app (campo "Token de acesso").
}
